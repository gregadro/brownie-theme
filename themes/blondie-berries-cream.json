  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#837160",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment doc tags",
      "scope": [
        "comment storage.type",
        "comment entity.name.type",
        "comment keyword"
      ],
      "settings": {
        "foreground": "#66513f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#b8382b"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#8f7b69",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#8c8178"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#3a2a20"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property",
        "entity.name.tag.yaml",
        "entity.name.tag.toml"
      ],
      "settings": {
        "foreground": "#6f5f52"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameters variable"
      ],
      "settings": {
        "foreground": "#8a52a0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language variable",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#6450b0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword, Storage",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#8a5d2c"
      }
    },
    {
      "name": "Arrow, Assignment operators",
      "scope": [
        "storage.type.function.arrow",
        "keyword.operator.assignment",
        "keyword.operator.type.annotation"
      ],
      "settings": {
        "foreground": "#8c8178"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#b84a00"
      }
    },
    {
      "name": "Class, Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "entity.name.namespace",
        "entity.name.module",
        "storage.type.java",
        "storage.type.cs"
      ],
      "settings": {
        "foreground": "#b03c4c"
      }
    },
    {
      "name": "Builtin type",
      "scope": [
        "support.type.primitive",
        "support.type.builtin",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#b03c4c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#a3533f"
      }
    },
    {
      "name": "Template expression",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#8a5d2c"
      }
    },
    {
      "name": "Template expression content",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#3a2a20"
      }
    },
    {
      "name": "Regular expression",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#1d7559"
      }
    },
    {
      "name": "Escape, Placeholder",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#1d7559"
      }
    },
    {
      "name": "Number, Constant",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#6450b0"
      }
    },
    {
      "name": "Unit",
      "scope": [
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#6450b0"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml"
      ],
      "settings": {
        "foreground": "#8a5d2c"
      }
    },
    {
      "name": "Component tag",
      "scope": [
        "support.class.component",
        "entity.name.tag.component"
      ],
      "settings": {
        "foreground": "#b03c4c"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#8c8178"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#6f5f52",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Vue directive",
      "scope": [
        "entity.other.attribute-name.html.vue",
        "punctuation.attribute-shorthand"
      ],
      "settings": {
        "foreground": "#b84a00",
        "fontStyle": "italic"
      }
