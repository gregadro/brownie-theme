  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#918479",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment doc tags",
      "scope": [
        "comment storage.type",
        "comment entity.name.type",
        "comment keyword"
      ],
      "settings": {
        "foreground": "#c9b8a6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#f07a6e"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#937865",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "keyword.operator",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#a89a8e"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#fff8f1"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.variable.property",
        "entity.name.tag.yaml",
        "entity.name.tag.toml"
      ],
      "settings": {
        "foreground": "#ad9073"
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter",
        "meta.parameters variable"
      ],
      "settings": {
        "foreground": "#d6bfe6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language variable",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#b8a9f0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword, Storage",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.word"
      ],
      "settings": {
        "foreground": "#d4a373"
      }
    },
    {
      "name": "Arrow, Assignment operators",
      "scope": [
        "storage.type.function.arrow",
        "keyword.operator.assignment",
        "keyword.operator.type.annotation"
      ],
      "settings": {
        "foreground": "#a89a8e"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#ee750b"
      }
    },
    {
      "name": "Class, Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "entity.name.namespace",
        "entity.name.module",
        "storage.type.java",
        "storage.type.cs"
      ],
      "settings": {
        "foreground": "#f4979c"
      }
    },
    {
      "name": "Builtin type",
      "scope": [
        "support.type.primitive",
        "support.type.builtin",
        "keyword.type"
      ],
      "settings": {
        "foreground": "#f4979c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#ffcf9e"
      }
    },
    {
      "name": "Template expression",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#d4a373"
      }
    },
    {
      "name": "Template expression content",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#fff8f1"
      }
    },
    {
      "name": "Regular expression",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#8fd6bb"
      }
    },
    {
      "name": "Escape, Placeholder",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#8fd6bb"
      }
    },
    {
      "name": "Number, Constant",
      "scope": [
        "constant",
        "constant.numeric",
        "constant.language",
        "constant.character",
        "support.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#b8a9f0"
      }
    },
    {
      "name": "Unit",
      "scope": [
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#b8a9f0"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml"
      ],
      "settings": {
        "foreground": "#d4a373"
      }
    },
    {
      "name": "Component tag",
      "scope": [
        "support.class.component",
        "entity.name.tag.component"
      ],
      "settings": {
        "foreground": "#f4979c"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#a89a8e"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ad9073",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Vue directive",
      "scope": [
        "entity.other.attribute-name.html.vue",
        "punctuation.attribute-shorthand"
      ],
      "settings": {
        "foreground": "#ee750b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#f4979c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS property",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "support.type.property-name.less",
        "support.type.vendored.property-name"
      ],
      "settings": {
        "foreground": "#ad9073"
      }
    },
    {
      "name": "CSS value",
