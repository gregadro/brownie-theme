{
  "name": "brownie",
  "displayName": "Brownie",
  "description": "A warm, colorful theme that tastes like a salted caramel brownie. Three flavors, each as a dark Brownie and a light Blondie.",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE.md",
  "icon": "icon.png",
  "publisher": "gregadro",
  "author": {
    "name": "Grega Drofenik",
    "email": "grega.drofenik@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gregadro/brownie-theme"
  },
  "homepage": "https://gregadro.github.io/brownie-theme/",
  "bugs": {
    "url": "https://github.com/gregadro/brownie-theme/issues"
  },
  "keywords": [
    "theme",
    "dark theme",
    "light theme",
    "brownie",
    "blondie",
    "caramel",
    "chocolate",
    "warm",
    "cozy",
    "pastel",
    "accessible",
    "vue"
  ],
  "galleryBanner": {
    "color": "#211a16",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.63.0"
  },
  "categories": [
    "Themes"
  ],
  "scripts": {
    "build": "node src/build.js",
    "icon": "node scripts/icon.mjs",
    "docs": "npm run build && node scripts/docs/render.mjs",
    "package": "npm run build && npx --yes @vscode/vsce@3 package",
    "publish": "npm run build && npx --yes @vscode/vsce@3 publish"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "shiki": "^1.29.2"
  },
  "contributes": {
    "themes": [
      {
        "label": "Brownie",
        "uiTheme": "vs-dark",
        "path": "./themes/brownie.json"
      },
      {
        "label": "Blondie",
        "uiTheme": "vs",
        "path": "./themes/blondie.json"
      },
      {
        "label": "Brownie Berries & Cream",
        "uiTheme": "vs-dark",
        "path": "./themes/brownie-berries-cream.json"
      },
      {
        "label": "Blondie Berries & Cream",
        "uiTheme": "vs",
        "path": "./themes/blondie-berries-cream.json"
      },
      {
        "label": "Brownie Pistachio & Cherry",
        "uiTheme": "vs-dark",
        "path": "./themes/brownie-pistachio-cherry.json"
      },
      {
        "label": "Blondie Pistachio & Cherry",
        "uiTheme": "vs",
        "path": "./themes/blondie-pistachio-cherry.json"
      }
    ]
  }
}
